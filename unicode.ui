  <property name="styleSheet">
   <string notr="true">/* Все поля: белый фон, тёмный текст */
QPlainTextEdit,
QLineEdit {
    background-color: #FFFFFF;
    color: #202124;
}

/* Поля ввода */
QPlainTextEdit#txt_text_input,
QLineEdit#txt_char_input,
QPlainTextEdit#txt_char_in_utf {
    background-color: #EFF6FF;
}

/* Заголовок и вводимый символ */
QLabel#labelTitle,
QLineEdit#txt_char_input {
    color: #2F48D9;
}

/* Подсказка под символом */
QLabel#txt_char_message {
    color: #52606D;
}</string>
